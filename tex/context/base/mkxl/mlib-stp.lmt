local kdfound          = kdtree.found

local newindex         = lua.newindex
local newtable         = lua.newtable

local newpoints        = vector.points.new
local cpypoints        = vector.points.copy
local getxy            = vector.points.getxy
local getxytable       = vector.points.getxytable
local setxy            = vector.points.setxy
local getbounds        = vector.points.getbounds
local gettriangle      = vector.points.gettriangle
local pointsindex      = vector.points.index
local growpoints       = vector.points.grow
