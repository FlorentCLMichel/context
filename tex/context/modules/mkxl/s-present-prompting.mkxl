%D \module
%D   [      file=s-present-prompting,
%D        version=2026.04.08,
%D          title=\CONTEXT\ Style File,
%D       subtitle=Presentation Environment prompting,
%D         author=Hans Hagen,
%D           date=\currentdate,
%D      copyright={PRAGMA ADE \& \CONTEXT\ Development Team}]
%C
%C This module is part of the \CONTEXT\ macro||package and is
%C therefore copyrighted by \PRAGMA. See mreadme.pdf for
%C details.

%D This style was made for Bacho\TeX\ 2026, and has prompts in the background. The
%D theme was linking Artificial Intelligence to \TeX, because in those years that
%D was happening everwhere and why should the usual ambitious not echo that.

% [sequence=123456,colors=123456]
% [sequence=234561,colors=123456]
% [sequence=345612,colors=123456]
% [sequence=456123,colors=123456]
% [sequence=561234,colors=123456]
% [sequence=612345,colors=123456]

% \setuppapersize[HD+][HD+]

\startmodule[present-prompting]

\startMPdefinitions
    string PromptColors[] ;

    PromptColors[1] := "darkyellow"  ;
    PromptColors[2] := "darkblue"    ;
    PromptColors[3] := "darkmagenta" ;
    PromptColors[4] := "darkgreen"   ;
    PromptColors[5] := "darkcyan"    ;
    PromptColors[6] := "darkred"     ;

    % 192 96 48 x 120 60 30

    def PromptBackground (expr sequence, colors) =
        picture p ;
        draw image (
            lmt_startpotraced [ bytes = "
                ....5.......2..........2.........3...5....1.4...
                .1...5..6....2..........2.....1...3...5....1.4..
                ..1...5..6....2..4.......2.....1...3...5..1...4.
                ...1.5..6..5...2..4.5...2.1.....1...3.5..1.....4
                ..1.2..6.4..5.2....4.5.2...1...1...3..2.1.....4.
                .1...2....4..5......4.5.3...1.6...3....2.....4..
                ......2....4..5....4.5...3...1.6.2......2.54....
                .....2....4..5....4.5.....3.1...6.2....2...5....
                3...2....4..5......5.....3.1...6...2..2.....5...
                .3.2.4.........6..5..1....1...6...2........5....
                ..3...4....3....6.....1..3...6...2.5.1....5..1..
                ...3...41...3....6.....1..3.2...2...5.1.4.....1.
                ..3.....41...3....6...1....3.2...6...5.1.4.....1
                .3.....4..1.3....6...1......3.2...6.5...1.4...1.
                3..6..4..1.3..1.6.2.1..5...3...2...6...1...4....
                .4..6...1.3....1...2....5.3...2.....61......4...
                ..4..6......6...1...2....5...2.....6.......4.2..
                ...4..6......6.1...2.3..5.4.2.....6....4..4...2.
                ..4..6......6.1...2...3....4.....6......4......2
                .4..6.1....6.....2.....3....4...6....3...4....2.
                4..6...1..6...........3......4...2....3...4..2..
                ........1......2..6..3...4..4.....2....3.4..1...
                .2.....1.3......2..6......4......2......3....1..
                ..2...1...3......2..6.5....4.1..2......3......1.
                ...2.1.....3....2....6.5....4.1.......3.5......1
                ....2.....3....2....6...5..4...1..6..3...5....1.
                ...2..1..3.6..1....6...5..5.....1..6....5.2..1..
                ..2....1....6..1..6...5....5...1....6..5...2....
                .2....1....6....1....5....5...1......65.....2...
                2....1....6....1.........5...1......6......2....
            " ] ;
            pickup pencircle scaled 0.2 ;
            for i = 0 upto 5 :
                filldraw lmt_potraced [
                    value = substring(i,i+1) of sequence
                ] withcolor PromptColors[ASCII (substring(i,i+1) of colors) - ASCII "0"] ;
                draw lmt_potraced [
                    value = substring(i,i+1) of sequence
                ] withcolor "white" ;
            endfor ;
            lmt_stoppotraced ;
        ) ysized PaperHeight withtransparency (1,.25) ;
        setbounds currentpicture
            to boundingbox currentpicture
            enlarged 10pt ;
        addbackground withcolor .6 ;
        currentpicture := currentpicture xysized (PaperWidth,PaperHeight) ;
    enddef ;
\stopMPdefinitions

% \startMPpage PromptBackground ("123456", "123456", "what is tex") ; \stopMPpage
% \startMPpage PromptBackground ("123456", "612345", "why using tex") ; \stopMPpage
% \startMPpage PromptBackground ("123456", "561234", "who uses tex") ; \stopMPpage
% \startMPpage PromptBackground ("123456", "456123", "who needs tex") ; \stopMPpage
% \startMPpage PromptBackground ("123456", "345612", "who likes tex") ; \stopMPpage
% \startMPpage PromptBackground ("123456", "234561", "who tex serves") ; \stopMPpage

\startuseMPgraphic{PromptBackground}
    PromptBackground ("\structureuservariable{sequence}", "\structureuservariable{colors}") ;
\stopuseMPgraphic

\usemodule[abbreviations-logos]

\setuppapersize
  [S6][S6]

\defineoverlay
  [PromptBackground]
  [\useMPgraphic{PromptBackground}]

\setupbackgrounds
  [page]
  [background=PromptBackground]

% numr ordn pnum tnum sups zero
% rand
% ss01 ss02 ss03 ss04 ss06 ss07 ss20

% \definefontfeature[default][default][rand=random]

\definefontfeature
  [default]
  [default]
  [rand=random]

\setupbodyfont
  [pennstander,16pt]

\setuphead
  [chapter]
  [align=flushright,
   before=,
   after=\blank[2*line],
   style=\bfd]

\setupcolors
  [textcolor=white]

\setuplayout
  [topspace=20pt,
   backspace=50pt,
   bottomspace=10pt,
   header=0pt,
   footer=0pt,
   leftmargin=30pt,
   leftmargindistance=10pt,
 % rightmargin=30pt,
 % rightmargindistance=10pt,
   width=middle,
   height=middle]

\setupinteraction
  [style=,
   color=]

\stopmodule

\continueifinputfile{s-present-prompting.mkxl}

\starttext

\setupmakeup[standard][bottom=\vfilll]

\startstandardmakeup
    % The war still rages on so as with previous meetings we use UA colors.
    \starttitle[title=exhibition][sequence=123456,colors=121212]
        \startalign[flushright]
            \start
                \bfa \setupinterlinespace
                someplace somewhere
                \blank[halfline]
                shown by me
            \stop
        \stopalign
    \stoptitle
\stopstandardmakeup

\startbuffer
\startitemize
    \startitem this is line one \stopitem
    \startitem and this is line two \stopitem
    \startitem and now line three \stopitem
\stopitemize
\stopbuffer

\startstandardmakeup
    \starttitle[title=exhibit two][sequence=123456,colors=123456]
        \getbuffer
    \stoptitle
\stopstandardmakeup

\startstandardmakeup
    \starttitle[title=exhibit three][sequence=234561,colors=123456]
        \getbuffer
    \stoptitle
\stopstandardmakeup

\startstandardmakeup
    \starttitle[title=exhibit four][sequence=345612,colors=123456]
        \getbuffer
    \stoptitle
\stopstandardmakeup

\startstandardmakeup
    \starttitle[title=exhibit five][sequence=456123,colors=123456]
        \getbuffer
    \stoptitle
\stopstandardmakeup

\startstandardmakeup
    \starttitle[title=exhibit six][sequence=561234,colors=123456]
        \getbuffer
    \stoptitle
\stopstandardmakeup

\startstandardmakeup
    \starttitle[title=who tex serves][sequence=612345,colors=123456]
        \getbuffer
    \stoptitle
\stopstandardmakeup

\stoptext
