            \bTD \Type{\letterbackslash letterleftbrace} \eTD
            \bTD \letterleftbrace \eTD
        \eTR
        \bTR
            \bTD \mono{\letterbar} \eTD
            \bTD vertical bar \eTD
            \bTD \Type{\letterbackslash type\letterleftbrace\letterbar\letterrightbrace} \eTD
