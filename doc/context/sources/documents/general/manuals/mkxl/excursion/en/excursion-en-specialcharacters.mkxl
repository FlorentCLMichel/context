            \bTD \Type{\letterbackslash letterampersand} \eTD
            \bTD \letterampersand \eTD
        \eTR
        \bTR
            \bTD \letterpercent \eTD
            \bTD percent \eTD
            \bTD \Type{\letterbackslash type\letterleftbrace\letterpercent\letterrightbrace} \eTD
            \bTD \mono{\letterpercent} \eTD
            \bTD \Type{\letterbackslash letterpercent} \eTD
            \bTD \letterpercent \eTD
        \eTR
        \bTR
            \bTD \letterbackslash \eTD
            \bTD backslash \eTD
            \bTD \Type{\letterbackslash type\letterleftbrace\letterbackslash\letterrightbrace} \eTD
