            \bTD[nx=2] Text \eTD
        \eTR
        \bTR[style=bold]
            \bTD Character \eTD
            \bTD Name \eTD
            \bTD Type \eTD
            \bTD Generates \eTD
            \bTD Type \eTD
            \bTD Generates \eTD
        \eTR
        \bTR
            \bTD \letterhash \eTD
            \bTD hashtag \eTD
            \bTD \Type{\letterbackslash type\letterleftbrace\letterhash\letterrightbrace} \eTD
            \bTD \mono{\letterhash} \eTD
            \bTD \Type{\letterbackslash letterhash} \eTD
            \bTD \letterhash \eTD
        \eTR
        \bTR
            \bTD \letterdollar \eTD
            \bTD dollar \eTD
            \bTD \Type{\letterbackslash type\letterleftbrace\letterdollar\letterrightbrace} \eTD
